<?xml version="1.0"?>
<!--
  SAR diff-drive robot for Gazebo Harmonic (multi-robot safe).

  Every frame, topic and sensor id is prefixed with `name` (e.g. robot_1), so N
  copies of this robot can coexist in one world without topic or tf collisions:

    frames : robot_1_base_link, robot_1_lidar_link, robot_1_camera_*
    topics : /robot_1/cmd_vel, /robot_1/odom, /robot_1/scan,
             /robot_1/image_raw, /robot_1/camera_info, /robot_1/joint_states

  Generate:  xacro sar_bot.urdf.xacro name:=robot_1
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">
  <xacro:arg name="name" default="robot_1"/>
  <xacro:property name="name" value="$(arg name)"/>

  <xacro:property name="wheel_radius" value="0.066"/>
  <xacro:property name="wheel_sep" value="0.288"/>

  <!-- ============================== links =============================== -->
  <link name="${name}_base_link">
    <visual>
      <geometry><box size="0.28 0.28 0.09"/></geometry>
      <material name="body"><color rgba="0.25 0.27 0.30 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.28 0.28 0.09"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.0185" ixy="0" ixz="0" iyy="0.0185" iyz="0" izz="0.0294"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <joint name="${name}_wheel_${side}_joint" type="continuous">
      <parent link="${name}_base_link"/>
      <child link="${name}_wheel_${side}_link"/>
      <origin xyz="0 ${y} -0.022" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}_wheel_${side}_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="0.03"/></geometry>
        <material name="tire"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.00033" ixy="0" ixz="0" iyy="0.00033" iyz="0" izz="0.00058"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_sep / 2}"/>
  <xacro:wheel side="right" y="${-wheel_sep / 2}"/>

  <xacro:macro name="caster" params="label x">
    <joint name="${name}_caster_${label}_joint" type="fixed">
      <parent link="${name}_base_link"/>
      <child link="${name}_caster_${label}_link"/>
      <origin xyz="${x} 0 -0.076" rpy="0 0 0"/>
    </joint>
    <link name="${name}_caster_${label}_link">
      <visual><geometry><sphere radius="0.014"/></geometry></visual>
      <collision>
        <geometry><sphere radius="0.014"/></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    </link>
  </xacro:macro>
  <xacro:caster label="front" x="0.12"/>
  <xacro:caster label="back" x="-0.12"/>

  <joint name="${name}_lidar_joint" type="fixed">
    <parent link="${name}_base_link"/>
    <child link="${name}_lidar_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>
  <link name="${name}_lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="sensor"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/></inertial>
  </link>

  <joint name="${name}_camera_joint" type="fixed">
    <parent link="${name}_base_link"/>
    <child link="${name}_camera_link"/>
    <origin xyz="0.14 0 0.08" rpy="0 0 0"/>
  </joint>
  <link name="${name}_camera_link">
    <visual><geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="sensor"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>
  <!-- ROS optical convention: z forward, x right, y down -->
  <joint name="${name}_camera_optical_joint" type="fixed">
    <parent link="${name}_camera_link"/>
    <child link="${name}_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="${name}_camera_optical_frame"/>

  <!-- ========================= gazebo sensors =========================== -->
  <gazebo reference="${name}_lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/${name}/scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>${name}_lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>5.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on><visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${name}_camera_link">
    <sensor name="camera" type="camera">
      <topic>/${name}/image_raw</topic>
      <camera_info_topic>/${name}/camera_info</camera_info_topic>
      <update_rate>10</update_rate>
      <gz_frame_id>${name}_camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.5</horizontal_fov>
        <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <always_on>1</always_on><visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ========================= gazebo systems =========================== -->
  <gazebo>
    <plugin name="diff_drive" filename="gz-sim-diff-drive-system">
      <left_joint>${name}_wheel_left_joint</left_joint>
      <right_joint>${name}_wheel_right_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/${name}/cmd_vel</topic>
      <odom_topic>/${name}/odom</odom_topic>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <max_angular_acceleration>3.14</max_angular_acceleration>
    </plugin>
    <plugin name="joint_state_publisher" filename="gz-sim-joint-state-publisher-system">
      <joint_names>${name}_wheel_left_joint ${name}_wheel_right_joint</joint_names>
      <topic>/${name}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
