<?xml version="1.0"?>
<package format="3">
  <name>sar_bringup</name>
  <version>0.1.0</version>
  <description>Multi-robot SAR mission launch: Gazebo, SLAM, perception, memory, allocation, Nav2, eval.</description>
  <maintainer email="sar-team@example.com">SAR Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sar_msgs</exec_depend>
  <exec_depend>sar_worlds</exec_depend>
  <exec_depend>sar_robot</exec_depend>
  <exec_depend>sar_slam</exec_depend>
  <exec_depend>sar_perception</exec_depend>
  <exec_depend>sar_memory</exec_depend>
  <exec_depend>sar_nav</exec_depend>
  <exec_depend>sar_alloc_rule</exec_depend>
  <exec_depend>sar_alloc_rl</exec_depend>
  <exec_depend>sar_eval</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
